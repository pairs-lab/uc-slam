<?xml version="1.0"?>
<package format="3">
  <name>ucslam_px4</name>
  <version>0.1.0</version>
  <description>Bridge from UC-SLAM odometry to PX4 through MAVROS: frame conversion to ENU/FLU, gating on the SLAM status, re-anchoring after map jumps.</description>
  <maintainer email="anonymous@example.com">Anonymous</maintainer>
  <license>GPL-3.0-or-later</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- the Python module tf2_ros, used only with use_tf -->
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
