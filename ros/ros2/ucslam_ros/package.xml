<?xml version="1.0"?>
<package format="3">
  <name>ucslam_ros</name>
  <version>0.1.0</version>
  <description>UC-SLAM for ROS 2 (Humble): the visual-inertial SLAM node with live metric depth, and the launch file.</description>
  <maintainer email="anonymous@example.com">Anonymous</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>ucslam_msgs</depend>
  <exec_depend>ucslam_depth</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
